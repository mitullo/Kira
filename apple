function RoleIntel:BindTheme(instance, properties)
    if self.Overlay and type(self.Overlay.BindTheme) == "function" then
        self.Overlay:BindTheme(instance, properties)
        return
    end

    -- Compatibility fallback for a stock external Fluent URL. FluentPlus v1.2.4
    -- replaces this path with its exact theme registry and acrylic shell.
    local fallback = {
        Accent = Color3.fromRGB(255, 70, 70),
        AcrylicMain = Color3.fromRGB(18, 18, 22),
        AcrylicBorder = Color3.fromRGB(55, 55, 66),
        Tab = Color3.fromRGB(28, 28, 34),
        Element = Color3.fromRGB(35, 35, 43),
        ElementBorder = Color3.fromRGB(53, 53, 64),
        InElementBorder = Color3.fromRGB(70, 70, 84),
        Text = Color3.fromRGB(240, 240, 245),
        SubText = Color3.fromRGB(170, 170, 180),
        TitleBarLine = Color3.fromRGB(55, 55, 66),
    }
    for property, themeKey in pairs(properties) do
        local value = fallback[themeKey]
        if value ~= nil then
            instance[property] = value
        end
    end
    table.insert(self.FallbackThemeBindings, {Instance = instance, Properties = properties})
end

function RoleIntel:MakeDraggable(handle)
    -- Keep Fluent's InputBegan/InputChanged pattern, but convert the initial 1,-356
    -- scale position to pixels before dragging. Dropping X.Scale made the old panel
    -- jump off-screen on the first movement.
    local dragging = false
    local dragInput = nil
    local startPointer = nil
    local startLocalPosition = nil

    local function parentOffset()
        local parent = self.Root and self.Root.Parent
        return parent and parent:IsA("GuiObject") and parent.AbsolutePosition or Vector2.zero
    end

    local function normalizeToOffset()
        if not self.Root or not self.Root.Parent then return end
        local parent = parentOffset()
        local absolute = self.Root.AbsolutePosition
        self.Root.Position = UDim2.fromOffset(absolute.X - parent.X, absolute.Y - parent.Y)
    end

    local function clampToViewport(absolute)
        local viewport = Camera.ViewportSize
        local size = self.Root.AbsoluteSize
        return Vector2.new(
            math.clamp(absolute.X, 8, math.max(8, viewport.X - size.X - 8)),
            math.clamp(absolute.Y, 8, math.max(8, viewport.Y - size.Y - 8))
        )
    end

    task.defer(normalizeToOffset)

    table.insert(self.DragConnections, handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        normalizeToOffset()
        dragging = true
        startPointer = input.Position
        startLocalPosition = Vector2.new(self.Root.Position.X.Offset, self.Root.Position.Y.Offset)
        local finishConnection
        finishConnection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragInput = nil
                if finishConnection then finishConnection:Disconnect() end
            end
        end)
    end))

    table.insert(self.DragConnections, handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(self.DragConnections, UserInputService.InputChanged:Connect(function(input)
        if input ~= dragInput or not dragging or not startPointer or not startLocalPosition or not self.Root or not self.Root.Parent then
            return
        end
        local delta = input.Position - startPointer
        local parent = parentOffset()
        local absolute = clampToViewport(parent + startLocalPosition + delta)
        self.Root.Position = UDim2.fromOffset(absolute.X - parent.X, absolute.Y - parent.Y)
    end))
end

