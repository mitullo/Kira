function RoleIntel:SetSectionEntries(key, entries)
    local section = self.Sections[key]
    if not section then
        return
    end

    local keys = {}
    for id, value in pairs(entries) do
        if value ~= nil and value ~= "" then
            table.insert(keys, id)
        end
    end
    table.sort(keys, function(a, b)
        return tostring(entries[a]):lower() < tostring(entries[b]):lower()
    end)

    for id, entry in pairs(section.Entries) do
        if entries[id] == nil then
            entry.Row:Destroy()
            section.Entries[id] = nil
        end
    end

    section.Empty.Visible = #keys == 0
    section.Count.Text = tostring(#keys)
    for index, id in ipairs(keys) do
        local entry = section.Entries[id] or self:CreateEntry(section, id, entries[id])
        entry.Label.Text = entries[id]
        entry.Row.LayoutOrder = index + 1
    end
end

function RoleIntel:Refresh()
    self:Create()
    if not self.Root then
        return
    end
    self.Root.Visible = self.Enabled
    if not self.Enabled then
        return
    end

    local kiras, takadas, goods = {}, {}, {}
    for username in pairs(kiraUsernames) do
        kiras[username] = roleDisplayName(username)
    end
    for username in pairs(takaUsernames) do
        takadas[username] = roleDisplayName(username)
    end
    for username in pairs(probableGoodUsernames) do
        goods[username] = roleDisplayName(username)
    end
    self:SetSectionEntries("Kira", kiras)
    self:SetSectionEntries("Takada", takadas)
    self:SetSectionEntries("Good", goods)
end

function RoleIntel:Destroy()
    for _, connection in ipairs(self.DragConnections) do
        connection:Disconnect()
    end
    table.clear(self.DragConnections)
    if self.Overlay and type(self.Overlay.Destroy) == "function" then
        self.Overlay:Destroy()
    elseif self.Gui then
        self.Gui:Destroy()
    end
    self.Gui = nil
    self.Root = nil
    self.Overlay = nil
    self.Header = nil
    self.Body = nil
    self.Sections = {}
    self.FallbackThemeBindings = {}
end

