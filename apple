	for _, id in ipairs(ids) do
		unbindID(id)
	end
	table.clear(Cache.IDPrompts)
	AutoDeathNoteController:ClearCrates()
end

local function bindIDMap(map)
	disconnectMapIDConnections()
	if not map then
		updateIDCollectList()
		return
	end

	MapIDScanToken += 1
	local scanToken = MapIDScanToken
	local function consider(object)
        if object.Name == "Id" and object:IsA("BasePart") then
            bindID(object)
            scheduleIDCollectListUpdate()
        elseif object.Name == "Crate" and object:IsA("BasePart") then
            AutoDeathNoteController:RegisterCrate(object)
        elseif object.Name == "IdPrompt" and object:IsA("ProximityPrompt") then
            Cache.IDPrompts[object] = true
            updatePrompt(object)
            queuePromptOverride(object)
            scheduleIDCollectListUpdate()
        elseif object.Name == "BinPrompt" and object:IsA("ProximityPrompt") then
            local crate = object.Parent
            if crate and crate:IsA("BasePart") and crate.Name == "Crate" then
                AutoDeathNoteController:RegisterCrate(crate)
            end
        end
    end

    -- One small batched traversal indexes both ID prompts and Death Note crates.
    walkTreeBatched(map, function()
        return scanToken == MapIDScanToken and map.Parent ~= nil
    end, consider, 12)

	table.insert(MapIDConnections, map.DescendantAdded:Connect(consider))
	table.insert(MapIDConnections, map.DescendantRemoving:Connect(function(object)
        if object.Name == "Id" and object:IsA("BasePart") then
            unbindID(object)
            scheduleIDCollectListUpdate()
        elseif object.Name == "Crate" and object:IsA("BasePart") then
            AutoDeathNoteController:UnregisterCrate(object)
        elseif object.Name == "IdPrompt" and object:IsA("ProximityPrompt") then
            Cache.IDPrompts[object] = nil
            scheduleIDCollectListUpdate()
        end
    end))

	refreshIDESP()
	scheduleIDCollectListUpdate()
end

