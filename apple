	end
	-- Consolidated Live Votes Updater
	if Options.LiveVotesUI and Options.LiveVotesUI.Value and ((currentTime - Cache.lastLiveVoteUpdate) >= 0.25) then
		Cache.lastLiveVoteUpdate = currentTime;
		if ReplicatedStorage.Game:FindFirstChild("VoteoutFolder") then
