local function bindID(id)
	if IDWatchers[id] or not id:IsA("BasePart") then
		return
	end

	local watcher = {Connections = {}, WasVisible = nil, Prompt = nil, Surface = nil, TakenProcessed = false}
	IDWatchers[id] = watcher

	local function attachPrompt(prompt)
		if watcher.Prompt or not prompt or not prompt:IsA("ProximityPrompt") or prompt.Name ~= "IdPrompt" then
			return
		end
		watcher.Prompt = prompt
		Cache.IDPrompts[prompt] = true
		updatePrompt(prompt)
        table.insert(watcher.Connections, prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
            renderID(id)
            scheduleIDCollectListUpdate()
            queuePromptOverride(prompt)
        end))
        table.insert(watcher.Connections, prompt:GetAttributeChangedSignal("PlayerName"):Connect(function()
            renderID(id)
            scheduleIDCollectListUpdate()
        end))
        table.insert(watcher.Connections, prompt:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            queuePromptOverride(prompt)
        end))
        table.insert(watcher.Connections, prompt:GetPropertyChangedSignal("MaxActivationDistance"):Connect(function()
            queuePromptOverride(prompt)
        end))
        table.insert(watcher.Connections, prompt:GetPropertyChangedSignal("RequiresLineOfSight"):Connect(function()
            queuePromptOverride(prompt)
        end))
	end

	local function attachSurface(surface)
		if watcher.Surface or not surface or not surface:IsA("SurfaceGui") or surface.Name ~= "SurfaceGui" then
			return
		end
		watcher.Surface = surface
		watcher.WasVisible = surface.Enabled
		table.insert(watcher.Connections, surface:GetPropertyChangedSignal("Enabled"):Connect(function()
			local wasVisible = watcher.WasVisible
			watcher.WasVisible = surface.Enabled
			renderID(id)
			scheduleIDCollectListUpdate()

			if wasVisible and not surface.Enabled then
                local phase = GameFolder:FindFirstChild("GamePhase")
                if phase and tostring(phase.Value) == "IdScatter" then
                    queueTakenID(id, watcher)
                end
            end
        end))
	end

	attachPrompt(id:FindFirstChild("IdPrompt"))
	attachSurface(id:FindFirstChild("SurfaceGui"))

	table.insert(watcher.Connections, id.DescendantAdded:Connect(function(child)
		if child.Name == "IdPrompt" then
			attachPrompt(child)
		elseif child.Name == "SurfaceGui" then
			attachSurface(child)
		end
		renderID(id)
	end))
	table.insert(watcher.Connections, id.AncestryChanged:Connect(function(_, parent)
		if not parent then
			unbindID(id)
		end
	end))

	renderID(id)
end

local MapIDConnections = {}
local MapIDScanToken = 0
local function disconnectMapIDConnections()
	MapIDScanToken += 1
	for _, connection in ipairs(MapIDConnections) do
