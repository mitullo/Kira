local function watchPlayerESP(player)
	if player == LocalPlayer or ESPWatchers[player] then
		return
	end
	local watcher = {Connections = {}, CharacterConnection = nil}
	ESPWatchers[player] = watcher

	local function watchCharacter(character)
		if watcher.CharacterConnection then
			watcher.CharacterConnection:Disconnect()
			watcher.CharacterConnection = nil
		end
		watcher.CharacterConnection = character.ChildAdded:Connect(function(child)
			if child.Name == "Head" then
				renderPlayerESP(player)
			end
		end)
		task.defer(renderPlayerESP, player)
	end

	table.insert(watcher.Connections, player.CharacterAdded:Connect(watchCharacter))
	table.insert(watcher.Connections, player.CharacterRemoving:Connect(function()
		if watcher.CharacterConnection then
			watcher.CharacterConnection:Disconnect()
			watcher.CharacterConnection = nil
		end
		destroyPlayerESP(player)
	end))
	table.insert(watcher.Connections, player:GetPropertyChangedSignal("DisplayName"):Connect(function()
		applyPlayerESPStyle(player)
	end))

	if player.Character then
		watchCharacter(player.Character)
	end
end

