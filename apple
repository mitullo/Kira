-- Walk a map in small slices instead of calling GetDescendants() on a fully replicated
-- map. This prevents a map-start allocation spike and lets the client keep rendering.
local function walkTreeBatched(root, isCurrent, visit, batchSize)
    batchSize = batchSize or 12
    task.spawn(function()
        local stack = {root}
        local processed = 0
        while #stack > 0 and root and root.Parent and (not isCurrent or isCurrent()) do
            local instance = table.remove(stack)
            local children = instance:GetChildren()
            for index = 1, #children do
                table.insert(stack, children[index])
            end
            if instance ~= root then
                visit(instance)
            end
            processed += 1
            if processed >= batchSize then
                processed = 0
                task.wait()
            end
        end
    end)
end

-- Edit this constant for Auto Death Note speed. Higher = slower.
local AUTO_DEATH_NOTE_DELAY = 2

-- The worker is intentionally single-instance. It stays enabled through lobby/intermission,
-- pauses while a round is unavailable, and wakes as soon as a Map/active GamePhase appears.
local AutoDeathNoteController = {
	Enabled = false,
	Running = false,
	Token = 0,
	Crates = {},
	CrateSet = {},
	CratesDirty = false,
	Index = 0,
	ScanToken = 0,
}

local function hasDetectedKira()
	return next(kiraUsernames) ~= nil
end

local function autoDeathNoteRoundActive()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return false
	end

	local phase = GameFolder:FindFirstChild("GamePhase")
	if not phase then
		return true
	end

	local normalized = string.lower(tostring(phase.Value))
	return normalized ~= "intermission" and normalized ~= "lobby" and normalized ~= "results"
end

function AutoDeathNoteController:ClearCrates()
	self.Crates = {}
	self.CrateSet = {}
	self.Index = 0
end

function AutoDeathNoteController:RegisterCrate(crate)
	if not crate or not crate:IsA("BasePart") or crate.Name ~= "Crate" or self.CrateSet[crate] then
		return
	end
	self.CrateSet[crate] = true
	table.insert(self.Crates, crate)
end

function AutoDeathNoteController:UnregisterCrate(crate)
	if not self.CrateSet[crate] then
		return
	end
	self.CrateSet[crate] = nil
	for index = #self.Crates, 1, -1 do
		if self.Crates[index] == crate then
			table.remove(self.Crates, index)
			break
		end
	end
	if self.Index > #self.Crates then
		self.Index = 0
	end
end

function AutoDeathNoteController:RefreshCrates()
	for index = #self.Crates, 1, -1 do
		local crate = self.Crates[index]
		if not crate or not crate.Parent then
			self.CrateSet[crate] = nil
			table.remove(self.Crates, index)
		end
	end
	self.CratesDirty = false
end

function AutoDeathNoteController:StartScan(map)
    -- Crates come from the shared ID/map indexer below. A second scan here caused map-start spikes.
    self.CratesDirty = true
end

function AutoDeathNoteController:GetNextCrate()
	self:RefreshCrates()
	local total = #self.Crates
	for _ = 1, total do
		self.Index = (self.Index % total) + 1
		local crate = self.Crates[self.Index]
		local prompt = crate and crate:FindFirstChild("BinPrompt")
		if crate and crate.Parent and prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
			return crate
		end
	end
	return nil
end

-- Local-only interaction helpers. These preserve the behaviour of the original script
-- without introducing a new premium RemoteEvent or server companion script.
local missingPromptHelperWarningShown = false

local function firePrompt(prompt, attempts, interval)
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	local promptFirer = fireproximityprompt
	if type(promptFirer) ~= "function" then
		if not missingPromptHelperWarningShown then
			missingPromptHelperWarningShown = true
			Fluent:Notify({
				Title = "Prompt helper unavailable",
				Content = "fireproximityprompt is not available in this client environment.",
				Icon = "triangle-alert",
				Duration = 6,
			})
		end
		return false
	end

	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 20)
	prompt.RequiresLineOfSight = false

	for _ = 1, attempts or 1 do
		if not prompt.Parent or not prompt.Enabled then
			break
		end
		promptFirer(prompt)
		task.wait(interval or 0.06)
	end
	return true
end

local function interactAtPart(part, prompt, attempts, interval)
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root or not part or not part:IsA("BasePart") then
		return false
	end

	local originalRootCFrame = root.CFrame
	local originalCameraType = Camera.CameraType
	local originalCameraCFrame = Camera.CFrame
	local success = false

	local ok, err = xpcall(function()
		local lookVector = part.CFrame.LookVector
		local targetPosition = part.Position + lookVector * 3
		Camera.CameraType = Enum.CameraType.Scriptable
		root.CFrame = CFrame.new(targetPosition, part.Position)
		Camera.CFrame = CFrame.new(targetPosition - lookVector * 2 + Vector3.new(0, 2, 0), part.Position)
		task.wait(0.08)
		success = firePrompt(prompt, attempts, interval)
	end, debug.traceback)

	if root.Parent then
		root.CFrame = originalRootCFrame
	end
	Camera.CameraType = originalCameraType
	Camera.CFrame = originalCameraCFrame

	if not ok then
		warn("[Special Kira] local prompt interaction failed:\n" .. tostring(err))
	end
	return ok and success
end

local function requestDeathNoteCrate(crate)
	if not crate or not crate.Parent then
		return false
	end
	local prompt = crate:FindFirstChild("BinPrompt")
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end
	return interactAtPart(crate, prompt, 2, 0.07)
end

function AutoDeathNoteController:Run(token)
	while self.Enabled and self.Token == token do
		if not autoDeathNoteRoundActive() or hasDetectedKira() then
			task.wait(0.45)
			continue
		end

		if self.CratesDirty then
			self:RefreshCrates()
		end

		local crate = self:GetNextCrate()
		if not crate then
			task.wait(0.6)
			continue
		end
		requestDeathNoteCrate(crate)

		-- Higher delay = slower scanning and less movement/camera work.
		task.wait(AUTO_DEATH_NOTE_DELAY)
	end

	if self.Token == token then
		self.Running = false
	end
end

function AutoDeathNoteController:SetEnabled(enabled)
	if enabled == self.Enabled and (not enabled or self.Running) then
		self.CratesDirty = true
		return
	end

	self.Enabled = enabled
	self.Token += 1
	self.CratesDirty = true
	if not enabled then
		self.Running = false
		return
	end

	self.Running = true
	self:StartScan(workspace:FindFirstChild("Map"))
	local token = self.Token
	task.spawn(function()
		self:Run(token)
	end)
end

function AutoDeathNoteController:NotifyRoundChanged()
	self.CratesDirty = true
	if self.Enabled then
		self:StartScan(workspace:FindFirstChild("Map"))
		if not self.Running then
			self:SetEnabled(true)
		end
	end
end

