local function closestNonLocalPlayer(position)
	local closestPlayer = nil
	local closestDistance = math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local distance = (root.Position - position).Magnitude
				if distance < closestDistance then
					closestPlayer = player
					closestDistance = distance
				end
			end
		end
	end
	return closestPlayer, closestDistance
end

local TakenIDQueue = {}
local TakenIDQueueRunning = false

local function queueTakenID(id, watcher)
    if not id or not watcher or watcher.TakenProcessed then return end
    watcher.TakenProcessed = true
    local owner = watcher.Prompt and watcher.Prompt:GetAttribute("PlayerName") or "Unknown"
    local ownerPlayer = Players:FindFirstChild(owner)
    table.insert(TakenIDQueue, {
        Position = id.Position,
        OwnerDisplay = ownerPlayer and ownerPlayer.DisplayName or owner,
    })
    if TakenIDQueueRunning then return end
    TakenIDQueueRunning = true

    task.defer(function()
        while #TakenIDQueue > 0 do
            local startTime = os.clock()
            repeat
                local item = table.remove(TakenIDQueue, 1)
                if item then
                    local candidate, distance = closestNonLocalPlayer(item.Position)
                    if candidate and distance <= 16 then
                        updateTakaList(candidate, item.OwnerDisplay)
                    end
                    createTakenIDWarning(item.Position, item.OwnerDisplay)
                end
            until #TakenIDQueue == 0 or (os.clock() - startTime) >= 0.0025
            if #TakenIDQueue > 0 then task.wait() end
        end
        TakenIDQueueRunning = false
    end)
end

